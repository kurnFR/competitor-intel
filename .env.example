# Competitor Promotion Intelligence Platform - environment template.
# Copy to .env and fill in real values. Never commit .env.

# Docker Compose only: password for the bundled PostgreSQL container
POSTGRES_PASSWORD=

DATABASE_URL=postgresql+psycopg://competitor_intel_app:<PASSWORD>@<DB_HOST>:5432/competitor_intel
DATABASE_URL_ADMIN=postgresql+psycopg://competitor_intel_owner:<PASSWORD>@<DB_HOST>:5432/competitor_intel
DATABASE_SCHEMA=competitor_intel

LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=auto/best-fast

APP_NAME=Competitor Promotion Intelligence Platform
APP_ENV=development
DEBUG=false
PORT=8000
HOST=127.0.0.1

# Login sessions. Serve the app over HTTPS in production and set APP_ENV=production
# (this turns on the Secure cookie flag). Leave SESSION_COOKIE_SECURE empty for automatic.
SESSION_COOKIE_SECURE=
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Two-factor login (authenticator app). SECRET_KEY is required to enable it; keep it safe and never change it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
MFA_REQUIRED_FOR_ADMINS=false
# Set true ONLY behind your own reverse proxy (uses X-Forwarded-For for the client IP)
TRUST_PROXY=false

# Optional weekly e-mail digest
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_RECIPIENTS=
# Optional Slack / Google Chat / Mattermost incoming-webhook URL (https)
DIGEST_WEBHOOK_URL=
DIGEST_DAY_OF_WEEK=mon
DIGEST_HOUR=8

# Optional key for automation (cron/CI) to call POST /api/v1/pipeline/run without a login.
# Required to use POST /api/v1/pipeline/run and the dashboard "Scan now" button.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Comma-separated extra browser origins allowed cross-origin (leave empty for same-origin only)
CORS_ORIGINS=

# Crawler etiquette. Add contact info so site owners can reach you, e.g.
# CRAWLER_USER_AGENT=CompetitorIntelBot/1.0 (+https://your-company.example/bot; marketing-intel@your-company.example)
CRAWLER_USER_AGENT=CompetitorIntelBot/1.0
CRAWLER_RESPECT_ROBOTS=true

# Default crawl frequency for NEW sources (1440 = daily). Each source has its own schedule on the Admin page.
CRAWL_INTERVAL_MINUTES=1440
# How often the scheduler checks which sources are due
SCHEDULER_TICK_MINUTES=30

# Data retention (daily). Old crawled pages lose their raw file and full text; evidence quotes and promotions are kept.
# The newest page of every website is never removed.
RETENTION_ENABLED=true
RETENTION_DOCUMENT_DAYS=90
RETENTION_AUDIT_DAYS=365
RETENTION_SCAN_RUN_DAYS=180
RETENTION_ALERT_DAYS=180
EXPIRATION_CHECK_MINUTES=15
UNDATED_PROMO_MAX_AGE_DAYS=14
MAX_CARDS_PER_DOCUMENT=300
CARDS_PER_LLM_BATCH=6
