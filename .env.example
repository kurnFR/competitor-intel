# Competitor Promotion Intelligence Platform - environment template.
# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+psycopg://competitor_intel_app:<PASSWORD>@<DB_HOST>:5432/competitor_intel
DATABASE_URL_ADMIN=postgresql+psycopg://competitor_intel_owner:<PASSWORD>@<DB_HOST>:5432/competitor_intel
DATABASE_SCHEMA=competitor_intel

REDIS_URL=redis://localhost:6379/0

LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=auto/best-fast

APP_NAME=Competitor Promotion Intelligence Platform
APP_ENV=development
DEBUG=false
PORT=8000
HOST=127.0.0.1

# Required to use POST /api/v1/pipeline/run and the dashboard "Scan now" button.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Comma-separated extra browser origins allowed cross-origin (leave empty for same-origin only)
CORS_ORIGINS=

# Crawler etiquette. Add contact info so site owners can reach you, e.g.
# CRAWLER_USER_AGENT=CompetitorIntelBot/1.0 (+https://your-company.example/bot; marketing-intel@your-company.example)
CRAWLER_USER_AGENT=CompetitorIntelBot/1.0
CRAWLER_RESPECT_ROBOTS=true

# 1440 = once per day; 30 = every 30 minutes
CRAWL_INTERVAL_MINUTES=1440
EXPIRATION_CHECK_MINUTES=15
UNDATED_PROMO_MAX_AGE_DAYS=14
MAX_CARDS_PER_DOCUMENT=300
CARDS_PER_LLM_BATCH=6
